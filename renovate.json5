{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // 個人リポジトリ共通の設定を継承（config:recommended・minimumReleaseAge・schedule・ラベルなど）
  // https://github.com/greendrop/renovate-config
  extends: ["github>greendrop/renovate-config:default.json5"],
  // 有効化するパッケージマネージャ
  enabledManagers: ["github-actions", "mise"],
  packageRules: [
    {
      matchManagers: ["github-actions", "mise"],
      // minor / patch は CI 通過後に GitHub の自動マージ機能でマージする
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      platformAutomerge: true,
    },
  ],
}
