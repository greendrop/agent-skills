{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  // 更新対象とするパッケージマネージャ
  enabledManagers: [
    "github-actions",
    "mise",
  ],
  // リリースから一定期間が経過するまで更新 PR を作成しない
  minimumReleaseAge: "7 days",
  timezone: "Asia/Tokyo",
  // 毎日 9 時（JST）に実行
  schedule: [
    "* 9 * * *",
  ],
  // 全 PR 共通のラベル
  labels: [
    "dependencies",
  ],
  "github-actions": {
    enabled: true,
  },
  mise: {
    enabled: true,
  },
  packageRules: [
    {
      // GitHub Actions の更新 PR には github-actions ラベルを付与
      matchManagers: ["github-actions"],
      addLabels: ["github-actions"],
    },
    {
      // mise 管理ツールの更新 PR には mise ラベルを付与
      matchManagers: ["mise"],
      addLabels: ["mise"],
    },
  ],
  rebaseWhen: "never",
}
